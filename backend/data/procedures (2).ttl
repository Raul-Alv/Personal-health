@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/procedimiento/1> a fhir:Procedure ;
    fhir:code "260930001" ;
    fhir:location [ fhir:reference "Tooth/1" ] ;
    fhir:performedDateTime "2025-04-12"^^xsd:date ;
    fhir:performer [ fhir:actor [ fhir:reference "Practitioner/1" ] ] ;
    fhir:status "preparation" ;
    fhir:subject [ fhir:reference [ fhir:value "Patient/1" ] ] .

<http://example.org/procedimiento/3> a fhir:Procedure ;
    fhir:code "299709002" ;
    fhir:location [ fhir:reference "Tooth/2" ] ;
    fhir:performedDateTime "2025-04-02"^^xsd:date ;
    fhir:performer [ fhir:actor [ fhir:reference "Practitioner/2" ] ] ;
    fhir:status "completed" ;
    fhir:subject [ fhir:reference [ fhir:value "Patient/1" ] ] .

