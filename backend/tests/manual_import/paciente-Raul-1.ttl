@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://hl7.org/fhir/Patient/1> a fhir:Patient ;
  fhir:Patient.name [
    fhir:HumanName.family [ fhir:value "Garcia" ] ;
    fhir:HumanName.given [ fhir:value "Raul" ]
  ] ;
  fhir:Patient.gender [ fhir:value "male" ] ;
  fhir:Patient.birthDate [ fhir:value "1995-03-12"^^xsd:date ] ;
  fhir:Patient.active [ fhir:value true ] ;
  fhir:Patient.identifier [
    fhir:Identifier.value [ fhir:value "RAUL-1" ] ;
    fhir:Identifier.system [ fhir:value "urn:personal-health:test" ]
  ] ;
  fhir:Patient.telecom [
    fhir:ContactPoint.value [ fhir:value "+34 600 000 001" ] ;
    fhir:ContactPoint.system [ fhir:value "phone" ]
  ] ;
  fhir:Patient.address [
    fhir:Address.line [ fhir:value "Calle de prueba 1" ] ;
    fhir:Address.city [ fhir:value "Madrid" ] ;
    fhir:Address.state [ fhir:value "Madrid" ] ;
    fhir:Address.postalCode [ fhir:value "28001" ] ;
    fhir:Address.country [ fhir:value "ES" ]
  ] ;
  fhir:Patient.maritalStatus [ fhir:value "S" ] .
