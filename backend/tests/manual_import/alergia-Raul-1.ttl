@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://hl7.org/fhir/AllergyIntolerance/3> a fhir:AllergyIntolerance ;
  fhir:AllergyIntolerance.patient [
    fhir:Reference.reference [ fhir:value "Patient/1" ] ;
    fhir:Reference.type [ fhir:value "Patient" ]
  ] ;
  fhir:AllergyIntolerance.clinicalStatus [
    fhir:CodeableConcept.coding [
      fhir:Coding.system [
        fhir:value "http://terminology.hl7.org/CodeSystem/allergyintolerance-clinical"^^xsd:anyURI
      ] ;
      fhir:Coding.code [ fhir:value "active" ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Activa" ]
  ] ;
  fhir:AllergyIntolerance.code [
    fhir:CodeableConcept.coding [
      fhir:Coding.system [ fhir:value "http://snomed.info/sct"^^xsd:anyURI ] ;
      fhir:Coding.code [ fhir:value "293707005" ] ;
      fhir:Coding.display [ fhir:value "Alergia a ketamina" ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Alergia a ketamina" ]
  ] ;
  fhir:AllergyIntolerance.verificationStatus [
    fhir:CodeableConcept.coding [
      fhir:Coding.system [
        fhir:value "http://terminology.hl7.org/CodeSystem/allergyintolerance-verification"^^xsd:anyURI
      ] ;
      fhir:Coding.code [ fhir:value "confirmed" ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Confirmada" ]
  ] ;
  fhir:AllergyIntolerance.category [ fhir:value "medication" ] ;
  fhir:AllergyIntolerance.criticality [ fhir:value "high" ] ;
  fhir:AllergyIntolerance.onsetDateTime [ fhir:value "2020-05-16"^^xsd:date ] ;
  fhir:AllergyIntolerance.actor [
    fhir:Reference.reference [ fhir:value "Practitioner/3" ] ;
    fhir:Reference.type [ fhir:value "Practitioner" ]
  ] .
