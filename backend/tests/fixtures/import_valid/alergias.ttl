@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://hl7.org/fhir/AllergyIntolerance/al-001> a fhir:AllergyIntolerance ;
  fhir:AllergyIntolerance.patient [
    fhir:Reference.reference [ fhir:value "Patient/pac-001" ] ;
    fhir:Reference.type [ fhir:value "Patient" ]
  ] ;
  fhir:AllergyIntolerance.code [
    fhir:CodeableConcept.coding [
      fhir:Coding.code [ fhir:value "227493005" ] ;
      fhir:Coding.system [ fhir:value "http://snomed.info/sct"^^xsd:anyURI ] ;
      fhir:Coding.display [ fhir:value "Cashew nuts" ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Alergia a frutos secos" ]
  ] ;
  fhir:AllergyIntolerance.clinicalStatus [
    fhir:CodeableConcept.coding [
      fhir:Coding.code [ fhir:value "active" ] ;
      fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/allergyintolerance-clinical"^^xsd:anyURI ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Activa" ]
  ] ;
  fhir:AllergyIntolerance.verificationStatus [
    fhir:CodeableConcept.coding [
      fhir:Coding.code [ fhir:value "confirmed" ] ;
      fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/allergyintolerance-verification"^^xsd:anyURI ]
    ] ;
    fhir:CodeableConcept.text [ fhir:value "Confirmada" ]
  ] ;
  fhir:AllergyIntolerance.category [ fhir:value "food" ] ;
  fhir:AllergyIntolerance.criticality [ fhir:value "high" ] ;
  fhir:AllergyIntolerance.onsetDateTime [ fhir:value "2024-11-02"^^xsd:date ] ;
  fhir:AllergyIntolerance.recorder [
    fhir:Reference.reference [ fhir:value "Practitioner/dra-lopez" ] ;
    fhir:Reference.type [ fhir:value "Practitioner" ]
  ] .
