@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://hl7.org/fhir/Patient/pac-001> a fhir:Patient ;
  fhir:Patient.name [
    fhir:HumanName.family [ fhir:value "Garcia" ] ;
    fhir:HumanName.given [ fhir:value "Ana" ] ;
    fhir:HumanName.given [ fhir:value "Maria" ]
  ] ;
  fhir:Patient.gender [ fhir:value "female" ] ;
  fhir:Patient.birthDate [ fhir:value "1990-05-14"^^xsd:date ] ;
  fhir:Patient.active [ fhir:value true ] ;
  fhir:Patient.identifier [
    fhir:Identifier.value [ fhir:value "12345678A" ] ;
    fhir:Identifier.system [ fhir:value "urn:oid:1.2.3.4" ]
  ] ;
  fhir:Patient.telecom [
    fhir:ContactPoint.value [ fhir:value "+34 600 123 123" ] ;
    fhir:ContactPoint.system [ fhir:value "phone" ]
  ] ;
  fhir:Patient.address [
    fhir:Address.line [ fhir:value "Calle Mayor 1" ] ;
    fhir:Address.city [ fhir:value "Madrid" ] ;
    fhir:Address.state [ fhir:value "Madrid" ] ;
    fhir:Address.postalCode [ fhir:value "28001" ] ;
    fhir:Address.country [ fhir:value "ES" ]
  ] ;
  fhir:Patient.maritalStatus [ fhir:value "S" ] .
